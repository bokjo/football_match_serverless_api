    "test:integration": "jest --testPathPattern=\"/test/\"",
    "test:integration:macos": "DOCKER_DEFAULT_PLATFORM=linux/arm64 jest --testPathPattern=\"/test/\"",
    "cdk": "cdk",
    "cdk:synth": "cdk synth",
    "cdk:deploy": "cdk deploy"
  },
  "devDependencies": {
